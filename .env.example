# CONTOH konfigurasi — salin menjadi .env lalu ganti SEMUA nilai "ganti_..." :
#   copy .env.example .env        (Windows CMD)      cp .env.example .env   (Linux/Mac)
# File .env berisi rahasia asli dan TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Nilai acak bisa dibuat dengan:  python scripts/gen_secret_key.py

PROJECT_NAME="Regulatory & Compliance Intelligence Platform (RCIP)"
ENVIRONMENT=development

# Kredensial database — POSTGRES_PASSWORD harus sama dengan password di DATABASE_URL.
# Catatan: password hanya dipasang saat volume database PERTAMA kali dibuat. Untuk database
# yang sudah ada, tetap pakai password lama.
POSTGRES_USER=rcip
POSTGRES_PASSWORD=ganti_dengan_password_database
POSTGRES_DB=rcip_db
DATABASE_URL=postgresql+psycopg://rcip:ganti_dengan_password_database@postgres:5432/rcip_db
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ganti_dengan_minio_user
MINIO_SECRET_KEY=ganti_dengan_minio_secret
MINIO_BUCKET_NAME=rcip-corpus

# Minimal 32 karakter acak (python scripts/gen_secret_key.py)
JWT_SECRET_KEY=ganti_dengan_jwt_secret_acak_minimal_32_karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Kosongkan OPENAI_API_KEY untuk memakai ekstraktor berbasis aturan (tanpa LLM)
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
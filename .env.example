PROJECT_NAME="Regulatory & Compliance Intelligence Platform (RCIP)"
ENVIRONMENT=development

POSTGRES_USER=rcip
POSTGRES_PASSWORD=rcip_dev_password
POSTGRES_DB=rcip_db
DATABASE_URL=postgresql+psycopg://rcip:rcip_dev_password@postgres:5432/rcip_db
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rcip_minio
MINIO_SECRET_KEY=rcip_minio_secret
MINIO_BUCKET_NAME=rcip-corpus

JWT_SECRET_KEY=change_this_to_a_secure_random_string_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Kosongkan OPENAI_API_KEY untuk memakai ekstraktor berbasis aturan (tanpa LLM)
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
